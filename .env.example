# Site server only. Never prefix these secrets with NEXT_PUBLIC_ or VITE_.
COMPANION_BRIDGE_URL=
COMPANION_BRIDGE_TOKEN=
COMPANION_VISITOR_TOKEN=
# Local bridge only. Use an independently logged-in Codex home.
COMPANION_CODEX_HOME=
COMPANION_PORT=8788
COMPANION_ALLOWED_ORIGINS=
CODEX_BIN=codex
# Linux isolated launcher and Cloudflare quick tunnel (absolute executable paths).
COMPANION_CODEX_NATIVE=
COMPANION_CLOUDFLARED=
